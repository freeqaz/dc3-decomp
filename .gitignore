# Miscellaneous
/*.txt
!requirements.txt
*.exe
*.pdb
_CL_*
agent-home/
archive/
# ...but docs/archive/ is the documentation archive and IS tracked. Without
# this negation the bare `archive/` rule above silently swallows every new
# file added under it (the 2026-08-17 audit's README and MANIFEST were both
# invisible to `git status` until this was fixed) — `git mv` only got its
# files in because a mv stages explicitly.
!docs/archive/
# Same trailing-slash blind spot as native/third_party below: `archive/` does
# not match the ROOT-LEVEL SYMLINK setup_worktree.sh plants, so every worktree
# showed `?? archive`. Anchored with a leading slash so docs/archive/ and
# native/archive/ are untouched by this line.
/archive
tmp/
logs/
ghidra_projects/
.env
/notes/
.env.*

# Doxygen output
doxygen/

# Generated patches from orchestrator
generated-patches/

# Scratch workspace for patch triage
scratch/
cl_temp_files/
# Same idea as scratch/, different name: per-lane triage artifacts (.obj.before
# snapshots, .patch candidates, run result JSON). Untracked and re-derivable, but
# it kept showing up as a dirty tree and inviting an accidental `git add -A`.
work/

# One-off analysis scripts
tools/retriage_85_100.py
scripts/build/inspect_pdata.py

# Generated databases
*.db
*.sqlite
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal

# Compiled extensions
*.so

# Backup files
*.backup
*.bak
*.bak2
*.tmp

# Shell config files (accidentally committed)
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc

# Git internal files (accidentally committed)
/HEAD
/hooks
/objects
/refs
native/HEAD
native/config
native/objects
native/refs
native/.claude/

# Log files
*.log

# Temp obj files
Z:*

# ImGui state file
imgui.ini

# Native ML models and third-party installs
native/models/
native/third_party/
# ...and the SYMLINKS scripts/setup_worktree.sh plants at those paths in a
# worktree. A trailing-slash pattern matches directories only, and a symlink to
# a directory is not a directory to gitignore — so without these anchored,
# slash-less forms every worktree carries permanent `?? native/third_party`
# noise and one blind `git add -A` commits a /home/free-specific symlink.
/native/models
/native/third_party

# Wave-3 Lane B unicorn-refresh worktree artifacts (results, not source)
/unicorn_refresh.db
/unicorn_refresh.json
/smoke_refresh.db
/smoke_refresh.json
/refresh_sweep.log
/decomp_copy.db
/decomp_before.db

# Generated audio decode cache (xma -> pcm), re-derivable from game assets
/sfx/
# objdiff report cache (binary, re-derivable)
/.objdiff_report_cache
# Transient permuter lock files (present only while a permuter run is active)
*.permuter.lock

# retired 8.6G shared ML venv, preserved for rollback (delete to reclaim space)
venv-legacy-ml/
uv-cache/
/venv

# MSVC/preprocessor expansion dumps (e.g. src/system/net/curl/lib/formdata.i)
*.i

# class_layout_report per-TU layout cache (tools/header_offset_audit_par.py)
.layout_cache/
