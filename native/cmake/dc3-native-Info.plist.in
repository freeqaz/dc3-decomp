<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded into dc3-native's __TEXT,__info_plist section on macOS
     (native/CMakeLists.txt, if(APPLE) after the dc3-native target). -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.milohax.dc3-native</string>
    <key>CFBundleName</key>
    <string>DC3 Native</string>
    <key>CFBundleExecutable</key>
    <string>dc3-native</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSCameraUsageDescription</key>
    <string>Dance Central 3 tracks your body through the camera (the MediaPipe pose server) so you can dance and navigate menus.</string>
</dict>
</plist>
