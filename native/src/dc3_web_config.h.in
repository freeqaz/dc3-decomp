// DC3 web-target consumer config — force-included into every dc3-web TU.
//
// Generated by native/CMakeLists.txt via configure_file(). Sets the engine's
// MILO_WEB_CANVAS_SELECTOR parameterisation macro (engine-side default is
// "#milo-canvas"). The `#` in the DOM-id string prevents CMake from passing
// the value as a -D on the command line, so we route it through a header.
//
// MILO_WEB_AUDIO_NS (the unquoted-identifier audio namespace macro) does
// pass cleanly via -D, so it stays as a target_compile_definitions entry.
#pragma once

#ifndef MILO_WEB_CANVAS_SELECTOR
#define MILO_WEB_CANVAS_SELECTOR "#dc3-canvas"
#endif
