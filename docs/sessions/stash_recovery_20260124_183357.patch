+
+    float dot2 = Dot(v3, v88);
+    float f2 = 0.0f;
+    if (dot2 >= mMaxViewAngleCos)
+        f2 = 1.0f;
+
+    float f7 = -(lensq * f - 1.0f);
+    if (IsNaN(f7)) {
+        MILO_NOTIFY("error scoring interest object: bad normalize factor gave score %f", f7);
+    }
+
+    float f4 = f7 + f2 + f1 - 0.99f;
+    if (f4 >= 0.0f) {
+        f4 = f4 + RandomFloat(-0.25f, 0.25f);
+    }
+    return f4 * mPriority;
+}
