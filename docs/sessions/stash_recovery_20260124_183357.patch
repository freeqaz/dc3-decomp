+void SkeletonChooser::SwapPlayerDataForPractice() {
+    static Symbol using_fitness("using_fitness");
+
+    // Get using_fitness from player 0's provider
+    HamPlayerData *player0 = TheGameData->Player(0);
+    PropertyEventProvider *provider0 = player0->Provider();
+    bool fitness0 = provider0->Property(using_fitness, true)->Int();
+
+    // Get using_fitness from player 1's provider
+    HamPlayerData *player1 = TheGameData->Player(1);
+    PropertyEventProvider *provider1 = player1->Provider();
+    bool fitness1 = provider1->Property(using_fitness, true)->Int();
+
+    // Swap using_fitness
+    TheGameData->Player(0)->SetUsingFitness(fitness1);
+    TheGameData->Player(1)->SetUsingFitness(fitness0);
+
+    // Get crew from player 0's provider
+    static Symbol crew("crew");
+    Symbol crew0 = TheGameData->Player(0)->Provider()->Property(crew, true)->Sym();
+    Symbol crew1 = TheGameData->Player(1)->Provider()->Property(crew, true)->Sym();
+
+    // Swap crews
+    TheGameData->Player(0)->SetCrew(crew1);
+    TheGameData->Player(1)->SetCrew(crew0);
+
+    // Swap characters
+    Symbol char0 = TheGameData->Player(0)->Char();
+    Symbol char1 = TheGameData->Player(1)->Char();
+    TheGameData->Player(0)->SetCharacter(char1);
+    TheGameData->Player(1)->SetCharacter(char0);
+
+    // Swap unk48
+    Symbol unk48_0 = TheGameData->Player(0)->Unk48();
+    Symbol unk48_1 = TheGameData->Player(1)->Unk48();
+    TheGameData->Player(0)->SetUnk48(unk48_1);
+    TheGameData->Player(1)->SetUnk48(unk48_0);
+
+    // Swap outfits
+    Symbol outfit0 = TheGameData->Player(0)->Outfit();
+    Symbol outfit1 = TheGameData->Player(1)->Outfit();
+    TheGameData->Player(0)->SetOutfit(outfit1);
+    TheGameData->Player(1)->SetOutfit(outfit0);
+
+    // Swap preferred outfits
+    Symbol prefOutfit0 = TheGameData->Player(0)->GetPreferredOutfit();
+    Symbol prefOutfit1 = TheGameData->Player(1)->GetPreferredOutfit();
+    TheGameData->Player(0)->SetPreferredOutfit(prefOutfit1);
+    TheGameData->Player(1)->SetPreferredOutfit(prefOutfit0);
+
+    // Swap pad numbers
+    int padNum0 = TheGameData->Player(0)->PadNum();
+    int padNum1 = TheGameData->Player(1)->PadNum();
+    TheGameData->SetAssociatedPadNum(0, padNum1);
+    TheGameData->SetAssociatedPadNum(1, padNum0);
+}
